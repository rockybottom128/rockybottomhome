---
interface Props { enabled:boolean; email?:string; source:'public'|'mls' }
const {enabled,email,source}=Astro.props;
---
<section class="intro"><p class="eyebrow">{source==='mls'?'MLS VIEWING REQUEST':'PLAN A VIEWING'}</p><h1>Start with<br /><em>your email.</em></h1><p>Verify your email before continuing. Real booking and identity checks are not enabled yet.</p><a href="/viewings/status/">View my verified account →</a></section>
<section class="card login-card" id="visitor-email-app"><p id="email-verified" hidden={!email}>Email verified{email?`: ${email}`:''}. Your visitor record is saved. You can continue to the simulated identity and scheduling demonstration.</p>{email && <p><a class="button" href="/viewings/demo/">Continue to viewing demo →</a></p>}<button id="visitor-signout" class="text-button" hidden={!email}>Use a different email</button><div id="email-entry" hidden={!!email}>{!enabled&&<p>Visitor demonstrations are currently paused. Please check back later.</p>}<form id="live-email-form"><fieldset disabled={!enabled}><label for="live-email">Email address (requires verification for bookings)<br /><span class="label-note">real-estate agents: use your business email address</span></label><input id="live-email" type="email" autocomplete="email" maxlength="254" required /><button class="button" type="submit">Email me a verification code</button></fieldset></form><form id="live-code-form" hidden><label for="live-code">Eight-digit email code</label><input id="live-code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{8}" maxlength="8" required /><div class="verification-actions"><button class="button" type="submit">Verify email</button><button id="live-resend" class="text-button" type="button">Resend code</button><button id="live-change" class="text-button" type="button">Change email</button></div></form></div><p id="live-email-result" role="status"></p><p class="hint">We save your email and verification result. No ID or selfie is collected at this step. Development email delivery is limited to approved test addresses.</p></section>
<script>import '../scripts/visitor-email';</script>

<style>
.verification-actions { display:flex; flex-wrap:wrap; align-items:center; gap:0.75rem 1.25rem; margin-top:1rem; }
.verification-actions .text-button { padding:0.5rem 0; }
</style>
