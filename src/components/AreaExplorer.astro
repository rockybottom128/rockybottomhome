---
import { places } from '../data/area';
import photos from '../data/area-photos.json';
const groups = [...new Set(places.map(place => place.group))];
---
<details class="area-explorer">
  <summary><span><span class="eyebrow">BEYOND ROCKY BOTTOM</span><span class="area-summary-title">Explore the area</span><span class="area-summary-description">Mountain towns, outdoor adventures, breweries & wineries</span></span><span class="area-expand" aria-hidden="true">+</span></summary>
  <div class="area-content" role="region" aria-label="Area attractions" aria-roledescription="carousel" tabindex="0">
    <div class="area-slides">
      {places.map((place, index) => {
        const photo = photos[place.id as keyof typeof photos];
        return <article class="area-slide" hidden={index !== 0} data-area-slide>
          <div class="area-photo"><img style={'fit' in photo ? `object-fit: ${photo.fit}` : undefined} src={photo.url} alt={photo.alt} loading="lazy" width="1400" height="950" draggable="false" /><span class="area-photo-count">{index + 1} / {places.length}</span><button class="photo-arrow photo-prev" data-area-step="-1" aria-label="Previous attraction">‹</button><button class="photo-arrow photo-next" data-area-step="1" aria-label="Next attraction">›</button></div>
          <div class="area-description"><p class="eyebrow">{place.category}</p><h3>{place.name}</h3><p>{place.description}</p><div class="area-links">{place.links.map(link => <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div><p class="area-credit">Photo source: <a href={photo.source} target="_blank" rel="noreferrer">{photo.author}</a>{photo.license && photo.licenseUrl && <> · <a href={photo.licenseUrl} target="_blank" rel="noreferrer">{photo.license}</a></>}<span> {photo.note}</span></p></div>
        </article>;
      })}
    </div>
    <nav class="area-destinations" aria-label="Choose an attraction">
      {groups.map((group, groupIndex) => <section class="area-destination-group" aria-labelledby={`area-group-${groupIndex}`}>
        <h4 id={`area-group-${groupIndex}`}>{group}</h4>
        <div class="area-thumbnail-grid">{places.map((place, index) => {
          if (place.group !== group) return null;
          const photo = photos[place.id as keyof typeof photos];
          return <button class="area-thumbnail" aria-label={`Show ${place.name}`} aria-current={index === 0 ? 'true' : 'false'} data-area-index={index}><span class="thumbnail-crop"><img src={photo.url} alt="" loading="lazy" width="180" height="110" /></span><span class="area-thumbnail-label">{place.name}</span></button>;
        })}</div>
      </section>)}
    </nav>
    <p class="area-status" aria-live="polite" aria-atomic="true">1 of {places.length} · {places[0].name}</p>
    <p class="area-visit-note">Swipe a photo or choose a destination below it. Follow the visitor links for current access, hours, and conditions.</p>
  </div>
</details>
<script>
  const root = document.querySelector<HTMLElement>('.area-explorer')!;
  const region = root.querySelector<HTMLElement>('.area-content')!;
  const slides = [...root.querySelectorAll<HTMLElement>('[data-area-slide]')];
  const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-area-index]')];
  let current = 0;
  function select(index: number) {
    const focus = document.activeElement as HTMLElement | null;
    const focusedArrow = slides[current].contains(focus) ? focus?.dataset.areaStep : undefined;
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => { slide.hidden = i !== current; });
    thumbs.forEach((thumb, i) => thumb.setAttribute('aria-current', String(i === current)));
    root.querySelector('.area-status')!.textContent = `${current + 1} of ${slides.length} · ${thumbs[current].querySelector('.area-thumbnail-label')!.textContent!.trim()}`;
    if (focusedArrow) slides[current].querySelector<HTMLButtonElement>(`[data-area-step="${focusedArrow}"]`)?.focus({ preventScroll: true });
  }
  root.querySelectorAll<HTMLButtonElement>('[data-area-step]').forEach(button => button.addEventListener('click', () => select(current + Number(button.dataset.areaStep))));
  thumbs.forEach((button, i) => button.addEventListener('click', () => {
    select(i);
    // Lower rows can be well below the featured photo, especially on phones.
    slides[current].scrollIntoView({ block: 'start', behavior: 'instant' });
  }));
  region.addEventListener('keydown', event => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    select(event.key === 'Home' ? 0 : event.key === 'End' ? slides.length - 1 : current + (event.key === 'ArrowRight' ? 1 : -1));
  });
  root.querySelectorAll<HTMLElement>('.area-photo').forEach(surface => {
    let start: { x: number; y: number; id: number } | null = null;
    surface.addEventListener('pointerdown', event => {
      if (event.pointerType === 'mouse' || !event.isPrimary || (event.target as HTMLElement).closest('button')) return;
      start = { x: event.clientX, y: event.clientY, id: event.pointerId };
      surface.setPointerCapture(event.pointerId);
    });
    surface.addEventListener('pointerup', event => {
      if (!start || start.id !== event.pointerId) return;
      const dx = event.clientX - start.x, dy = event.clientY - start.y;
      start = null;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.3) select(current + (dx < 0 ? 1 : -1));
    });
    surface.addEventListener('pointercancel', () => { start = null; });
  });
</script>
