---
import type {BookingEmail} from '../server/booking-mail';
interface Props { emails?:BookingEmail[];  bookings:Array<{id:string;starts_at:number;ends_at:number;status:string;revision:number;validation_status:string;cancellation_reason:string;email_normalized?:string;profile_snapshot?:string|null}>; owner?:boolean }
const {bookings,owner=false,emails=[]}=Astro.props;
const deliveryLabels:Record<string,string>={pending:"Awaiting send",sending:"Sending or outcome unknown — do not resend; check the mail provider if this persists",sent:"Accepted by email service (inbox delivery not confirmed)",failed:"Not sent — review mail settings or limits, then retry",uncertain:"Outcome unknown — check the mail provider; automatic retry is disabled",canceled:"Superseded — not sent"};
function emailBody(raw:string){try{return String(JSON.parse(raw).text??'');}catch{return 'Message unavailable';}}
const date=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',dateStyle:'medium',timeStyle:'short'});
function details(raw?:string|null):string {
 try{const p=JSON.parse(raw??'null');if(!p)return '';return [p.display_name,p.role==='agent'?'Agent':'Prospective buyer',...(p.role==='agent'?[p.licensed_name,p.jurisdiction,p.license_number,p.brokerage]:[])].filter(x=>typeof x==='string').join(' · ');}catch{return '';}
}
---
{!bookings.length&&<p>No saved requests for this selection.</p>}
{bookings.map(b=><article class="booking-row"><h3>{date.format(b.starts_at)}–{new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',timeStyle:'short'}).format(b.ends_at)} Eastern</h3><p><strong>{b.status==='requested'?'Pending owner approval':b.status==='approved'?'Approved':b.status==='canceled'?'Canceled':'Completed'}</strong>{b.email_normalized&&<> · {b.email_normalized}</>}</p>{owner&&b.profile_snapshot&&<p>{details(b.profile_snapshot)}</p>}<p class="hint">{b.validation_status==='simulated_pass'?'Identity/agent validation: simulated pass.':'Identity/agent validation: not verified.'} No access code is issued. Approval and cancellation updates are emailed to the visitor's verified address; this page shows the saved status.</p>{b.cancellation_reason&&<p>Cancellation reason: {b.cancellation_reason}</p>}
{owner&&b.status==='requested'&&b.starts_at>Date.now()&&<form class="booking-action-form" data-owner="true" data-booking-id={b.id} data-revision={b.revision} data-action="approve"><label class="check"><input type="checkbox" name="acknowledge" required /> I understand that identity and agent validation are simulated, and approve this visit.</label><button type="submit" class="button">Approve request</button><p class="booking-result" role="status"></p></form>}
{['requested','approved'].includes(b.status)&&b.ends_at>Date.now()&&<form class="booking-action-form" data-owner={String(owner)} data-booking-id={b.id} data-revision={b.revision} data-action="cancel"><label>Cancellation reason<textarea name="reason" required minlength="5" maxlength="1000"></textarea></label><p class="hint">{owner?'This reason will be emailed to the visitor.':'A cancellation confirmation will be emailed to you.'} Cancellation releases the held time.</p><button type="submit" class="button secondary">Cancel and email reason</button><p class="booking-result" role="status"></p></form>}
{owner&&['requested','approved'].includes(b.status)&&b.starts_at>Date.now()&&<details><summary>Send the visitor a message</summary><form class="booking-action-form" data-owner="true" data-booking-id={b.id} data-revision={b.revision} data-action="message"><label>Message<textarea name="message" required minlength="5" maxlength="2000"></textarea></label><p class="hint">Emails this request's verified visitor. Available only for an upcoming pending or approved visit. Sending a message does not change the booking. Replies are not received in this dashboard.</p><button type="submit" class="button secondary">Send email</button><p class="booking-result" role="status"></p></form></details>}
{owner&&emails.some(e=>e.booking_id===b.id)&&<details open><summary>Booking email history</summary><ul class="booking-mail-history">{emails.filter(e=>e.booking_id===b.id).map(e=><li><strong>{e.kind==='followup'?'Owner message':'Booking update'}</strong> · {date.format(e.created_at)}<br />{e.status==='sent'&&e.provider_message_id==='local-test'?'Saved in local test inbox (no email sent)':deliveryLabels[e.status]??'Unknown status'}<details><summary>View email</summary><pre>{emailBody(e.payload_json)}</pre></details>{['pending','failed'].includes(e.status)&&e.booking_revision===b.revision&&(b.status==='canceled'||b.starts_at>Date.now())&&<form class="booking-action-form" data-owner="true" data-email-id={e.id} data-action="send-email"><button class="button secondary" type="submit">{e.status==='failed'?'Retry email':'Send queued email'}</button><p class="booking-result" role="status"></p></form>}</li>)}</ul></details>}
</article>)}
<script>import '../scripts/booking-actions';</script>
