<section class="card" id="report-history"><h2>Punch-list report history</h2><p>Latest 100 recipient records. Acceptance is not proof of inbox delivery. Unknown outcomes must be checked with the provider before sending another report.</p><p id="report-history-mode" class="hint"></p><button type="button" class="text-button" id="report-history-refresh">Refresh history</button><p id="report-history-notice" role="status"></p><ul id="report-history-list"></ul></section>
<script>
import {reportDeliveryLabel,reportModeNotice} from '../lib/report-delivery';
async function refresh(){const notice=document.getElementById('report-history-notice')!;try{const r=await fetch('/api/owner/punch-reports',{cache:'no-store'});const v=await r.json();if(!r.ok)throw Error(v.error||'History unavailable.');document.getElementById('report-history-mode')!.textContent=reportModeNotice(v.deliveryMode);const list=document.getElementById('report-history-list')!;list.replaceChildren();for(const row of v.history){const li=document.createElement('li');li.textContent=new Date(row.created_at).toLocaleString()+' · '+row.recipient+' · '+reportDeliveryLabel(row.status,Boolean(row.localTest),row.recovery_outcome);if(row.canSend){const b=document.createElement('button');b.type='button';b.className='text-button';b.textContent=v.deliveryMode==='test'?'Save/retry local test (no email)':'Send/retry unsent recipients';b.addEventListener('click',async()=>{b.disabled=true;try{const response=await fetch('/api/owner/punch-reports',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'send',id:row.id,deliveryMode:v.deliveryMode})});const result=await response.json();if(!response.ok)throw Error(result.error||'Unable to confirm report action.');await refresh();}catch(e){notice.textContent=e instanceof Error?e.message:'Unable to confirm send. Refresh history before another action.';}});li.append(' ',b);}list.append(li);}notice.textContent=v.history.length?'':'No reports yet.';}catch(e){notice.textContent=e instanceof Error?e.message:'Report history unavailable. Refresh to try again.';}}
document.getElementById('report-history-refresh')!.addEventListener('click',refresh);window.addEventListener('punch-report-sent',refresh);void refresh();
</script>
