---
import '../styles/viewings.css';
import SiteVersion from '../components/SiteVersion.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{title} | Rocky Bottom Home</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="preview-notice">DESIGN PREVIEW · Bookings, identity checks and home access are not yet enabled.</div>
    <header class="portal-header"><a class="brand" href="/">R·B <span>ROCKY BOTTOM HOME</span></a><nav aria-label="Viewing navigation"><a href="/viewings">Plan a visit</a><a href="/viewings/status">My bookings</a><a href="/owner">Owner area</a></nav></header>
    <main id="main"><slot /></main>
    <footer><span>Rocky Bottom · Sunset, SC</span><a href="/">Return to the home</a><SiteVersion /></footer>
  </body>
</html>
