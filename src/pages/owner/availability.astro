---
export const prerender = false;
import { timeLabel } from '../../lib/viewings/calendar';
import ViewingLayout from '../../layouts/ViewingLayout.astro';
const times = Array.from({ length:97 },(_,i)=>`${String(Math.floor(i/4)).padStart(2,'0')}:${String(i%4*15).padStart(2,'0')}`);
---
<ViewingLayout title="Owner availability">
<section class="intro"><p class="eyebrow">OWNER AVAILABILITY · SHARED CALENDAR</p><h1>Plan ahead.<br /><em>Make time your own.</em></h1><p>Save available times and blocks for all owners and verified visitors. Times use America/New_York. Submitted requests hold their slot pending owner approval; simply viewing a time does not reserve it.</p><a href="/owner/dashboard/">← Owner dashboard</a></section>
<p id="availability-result" role="status" aria-live="polite">Loading calendar…</p><button id="reload-calendar" class="button secondary" type="button">Reload shared calendar</button>
<div id="availability-app" class="two-col">
<section class="card"><div class="calendar-nav"><button class="text-button" id="previous-month" type="button">← Previous</button><label for="owner-month">Month<input id="owner-month" type="month" min="2000-01" max="2099-12" /></label><button class="text-button" id="next-month" type="button">Next →</button></div><button class="text-button" id="today-month" type="button">Back to this month</button><div class="calendar-grid" id="owner-calendar" role="group" aria-label="Owner availability calendar"></div><p class="hint">Choose a day to see future one-hour slots. No time is available until an owner adds an available period.</p></section>
<section class="card"><h2 id="owner-selected-day"></h2><p id="day-state"></p><button class="button secondary" id="toggle-day" type="button" data-mutation>Block entire day</button><div class="slot-tiles" id="owner-slots"></div><p class="hint">Blocks always win. Removing a block restores time only where an available period permits it. Existing requests must be canceled from the dashboard before a calendar edit can block their time.</p></section>
<section class="card"><p class="eyebrow">AVAILABLE PERIODS AND BLOCKS</p><h2 id="period-heading">Add a time range.</h2><form id="rule-form">
<label for="rule-kind">Type</label><select id="rule-kind"><option value="available">Available</option><option value="blocked">Blocked</option></select>
<label for="rule-scope">Applies to</label><select id="rule-scope"><option value="date">Selected date</option><option value="weekly">Recurring weekly</option></select>
<label for="rule-date">Date (dated periods only)</label><input id="rule-date" type="date" min="2000-01-01" max="2099-12-31" />
<label for="rule-weekday">Recurring day (weekly ranges only)</label><select id="rule-weekday"><option value="-1">Every day</option>{['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].map((d,i)=><option value={i}>{d}</option>)}</select>
<div class="field-pair"><div><label for="rule-start">Start</label><select id="rule-start" required>{times.slice(0,-1).map(t=><option value={t} selected={t==='09:00'}>{timeLabel(t)}</option>)}</select></div><div><label for="rule-end">End</label><select id="rule-end" required>{times.slice(1).map(t=><option value={t} selected={t==='17:00'}>{timeLabel(t)}</option>)}</select></div></div>
<button class="button" type="submit" data-mutation id="save-period">Save period</button><button class="text-button" type="button" id="cancel-edit">Clear edit</button><p id="rule-error" role="status"></p></form>
<p class="hint">Quarter-hour range boundaries; one-hour visitor slots begin on the hour and must fit completely inside available time. Split overnight periods into two dates or weekdays. Ambiguous or missing daylight-saving times are excluded.</p></section>
<section class="card"><p class="eyebrow">SAVED SHARED SETTINGS</p><h2>Weekly rules and dated exceptions.</h2><ul id="rule-list"></ul><p class="hint">Edits are recorded with your owner account. Reload to see changes made by another owner. An outdated edit is rejected for review.</p></section>
</div><script>import '../../scripts/owner-availability';</script>
</ViewingLayout>
