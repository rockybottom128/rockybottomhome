---
export const prerender=false;
import BookingRequests from '../../components/BookingRequests.astro';
import {ownerCalendar} from '../../server/owner-calendar';
import {dayKey} from '../../lib/viewings/calendar';
import {bookingEmails} from '../../server/booking-mail';
import OwnerShowingCalendar from '../../components/OwnerShowingCalendar.astro';
import OwnerWorkflowDemo from '../../components/OwnerWorkflowDemo.astro';
import ViewingLayout from '../../layouts/ViewingLayout.astro';
import { runtime } from '../../server/runtime';
import { configured } from '../../server/env';
import { visitorDemoEnabled } from '../../server/settings';
import { readActivity } from '../../server/activity';
import { getOwner } from '../../server/owner-auth';
const env=runtime();
if(!configured(env,Astro.request))return Astro.redirect('/owner/',303);
const owner=await getOwner(env,Astro.request);if(!owner)return Astro.redirect('/owner/',303);
const demoEnabled=await visitorDemoEnabled(env);
const owners=await env.DB.prepare("SELECT id,email_normalized,status FROM owner_accounts WHERE status!='removed' ORDER BY created_at").all<{id:string;email_normalized:string;status:string}>();
const visitors=await env.DB.prepare('SELECT email_normalized,email_verified_at FROM visitors ORDER BY created_at DESC LIMIT 50').all<{email_normalized:string;email_verified_at:number|null}>();
const calendar=await ownerCalendar(env,Astro.url.searchParams);
const emails=await bookingEmails(env,calendar.bookings.map(b=>b.id));
const attention=await env.DB.prepare(`SELECT e.id,e.booking_id,e.status,e.kind,e.created_at,b.starts_at,v.email_normalized FROM email_outbox e JOIN bookings b ON b.id=e.booking_id JOIN visitors v ON v.id=b.visitor_id WHERE e.created_at IS NOT NULL AND e.status IN ('pending','failed','uncertain','sending') ORDER BY e.created_at LIMIT 100`).all<{id:string;booking_id:string;status:string;kind:string;created_at:number;starts_at:number;email_normalized:string}>();
let activity:Awaited<ReturnType<typeof readActivity>>=[];let activityError=false;
try{activity=await readActivity(env);}catch{activityError=true;}
const activityTime=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',dateStyle:'medium',timeStyle:'short'});
---
<ViewingLayout title="Owner dashboard">
<div slot="dashboard-heading" class="dashboard-identity"><h1>PRIVATE OWNER DASHBOARD</h1><p>Signed in as {owner.email_normalized}</p></div>
<div slot="dashboard-controls" class="dashboard-header-controls"><div class="visitor-booking-control"><div class="visitor-booking-toggle-row"><span><span id="visitor-booking-label">Visitor email verification and booking requests:</span> <strong id="visitor-booking-state">{demoEnabled?'Enabled':'Disabled'}</strong></span><button id="visitor-booking-toggle" class="setting-toggle" type="button" role="switch" aria-checked={String(demoEnabled)} aria-labelledby="visitor-booking-label"></button></div><p id="visitor-settings-result" class="hint" role="status"></p><a id="visitor-settings-reload" href="" hidden>Refresh to check the saved setting</a></div><button id="owner-signout" class="button secondary">Sign out</button></div>
<div class="stats" aria-label="Live showing totals"><div class="card stat"><strong>{calendar.pending}</strong>Pending review</div><div class="card stat"><strong>{calendar.approved}</strong>Approved showings</div><a class="card stat" href="#booking-email-attention"><strong>{calendar.attention}</strong>Emails needing attention</a></div>
<p class="hint">Showing totals include upcoming and in-progress visits. Saved in the shared database.</p>
<div class="two-col showing-review"><OwnerShowingCalendar calendar={calendar} /><section class="card" id="selected-showings"><p class="eyebrow">SELECTED DAY · {calendar.day}</p><h2>Requests and showings.</h2><p class="hint">Up to 100 records for this day, with pending and approved visits first. Visitor-provided details are not independently verified. Approvals and cancellations email the visitor. To change a time, cancel with a reason and ask the visitor to choose another slot.</p><BookingRequests bookings={calendar.bookings} emails={emails} owner /></section></div>
<section class="card dashboard-settings" id="booking-email-attention"><h2>Emails needing attention</h2><p class="hint">Email acceptance is not proof of inbox delivery. Unknown sends are not retried automatically. Incoming replies go to the configured reply-to address; this dashboard does not receive them.</p>{!attention.results.length?<p>No outstanding booking emails.</p>:<><p>Showing the oldest {attention.results.length} outstanding email records.</p><ul>{attention.results.map(e=><li><a href={`?month=${dayKey(e.starts_at).slice(0,7)}&day=${dayKey(e.starts_at)}#selected-showings`}>{activityTime.format(e.starts_at)} · {e.email_normalized}</a> · {e.status==='sending'?'Sending or outcome unknown':e.status==='uncertain'?'Outcome unknown':e.status==='failed'?'Not sent': 'Awaiting send'}</li>)}</ul></>}</section>
<div class="two-col"><section class="card" id="shared-availability"><p class="eyebrow">AVAILABILITY · SHARED CALENDAR</p><h2>Make room for a visit.</h2><a class="button secondary" href="/owner/availability/">Manage shared availability and blocks →</a><p>Available periods and blocks are saved for all owners and verified visitors. Times use Eastern Time. Submitted requests hold a slot pending owner approval. Identity and agent validation remain simulated.</p></section>
<section class="card" id="shared-activity"><p class="eyebrow">ACTIVITY · SAVED HISTORY</p><h2>A record of real changes.</h2><p class="hint">Latest 50 recorded changes · Eastern Time. Refresh this page for updates. Includes calendar edits, owner invitations/removals, password setup/reset, completed visitor verification, saved profiles, booking requests/approvals/cancellations and visitor-booking settings. Sample controls below do not create saved activity.</p>{activityError?<p role="status">Activity could not be loaded. Refresh to try again.</p>:activity.length?<ol class="log">{activity.map(item=><li><strong>{item.title}</strong><br /><time datetime={new Date(item.createdAt).toISOString()}>{activityTime.format(item.createdAt)}</time> · {item.actor}{item.detail&&<p>{item.detail}</p>}</li>)}</ol>:<p>No recorded changes yet.</p>}</section></div>
<div class="two-col"><section class="card"><h2>Visitor email verification</h2><ul>{visitors.results.map(v=><li>{v.email_normalized} · {v.email_verified_at?'Email verified':'Awaiting verification'}</li>)}</ul>{!visitors.results.length&&<p>No visitor records yet.</p>}</section>
<section class="card"><h2>Owner accounts</h2><p>All active owners have equal permissions. Owner invitations can use any valid email address, independently of the visitor test domains.</p><ul>{owners.results.map(o=><li>{o.email_normalized} · {o.status} <button type="button" class="text-button" data-remove-owner={o.id}>Remove owner</button></li>)}</ul><form id="owner-invite"><label for="invite-email">New owner's email</label><input id="invite-email" type="email" required maxlength="254" /><button class="button" type="submit">Send owner invitation</button></form><p id="owner-action-result" role="status"></p></section></div><section class="intro" aria-labelledby="workflow-heading"><p class="eyebrow">INTERACTIVE WORKFLOW PREVIEW</p><h2 id="workflow-heading">Explore the remaining previews.</h2><p>These sample controls demonstrate automation and conversations. They use fictional data, do not send emails or create access codes, and do not change the real records above. Sample changes clear when this page reloads.</p></section><OwnerWorkflowDemo connected /><script>import '../../scripts/owner-dashboard';</script></ViewingLayout>
