---
export const prerender=false;
import BookingRequests from '../../components/BookingRequests.astro';
import {ownerBookings} from '../../server/bookings';
import OwnerWorkflowDemo from '../../components/OwnerWorkflowDemo.astro';
import ViewingLayout from '../../layouts/ViewingLayout.astro';
import { runtime } from '../../server/runtime';
import { configured } from '../../server/env';
import { visitorDemoEnabled } from '../../server/settings';
import { readActivity } from '../../server/activity';
import { getOwner } from '../../server/owner-auth';
const env=runtime();
if(!configured(env,Astro.request))return Astro.redirect('/owner/',303);
const owner=await getOwner(env,Astro.request);if(!owner)return Astro.redirect('/owner/',303);
const demoEnabled=await visitorDemoEnabled(env);
const owners=await env.DB.prepare("SELECT id,email_normalized,status FROM owner_accounts WHERE status!='removed' ORDER BY created_at").all<{id:string;email_normalized:string;status:string}>();
const visitors=await env.DB.prepare('SELECT email_normalized,email_verified_at FROM visitors ORDER BY created_at DESC LIMIT 50').all<{email_normalized:string;email_verified_at:number|null}>();
const bookings=await ownerBookings(env);
const counts=await env.DB.prepare("SELECT COUNT(*) AS count FROM bookings WHERE status='requested' AND starts_at>?").bind(Date.now()).first<{count:number}>();
let activity:Awaited<ReturnType<typeof readActivity>>=[];let activityError=false;
try{activity=await readActivity(env);}catch{activityError=true;}
const activityTime=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',dateStyle:'medium',timeStyle:'short'});
---
<ViewingLayout title="Owner dashboard"><section class="intro"><p class="eyebrow">PRIVATE OWNER DASHBOARD</p><h1>Welcome back.</h1><p>Signed in as {owner.email_normalized}</p><button id="owner-signout" class="button secondary">Sign out</button></section>
<div class="two-col"><section class="card" id="shared-availability"><p class="eyebrow">AVAILABILITY · SHARED CALENDAR</p><h2>Make room for a visit.</h2><a class="button secondary" href="/owner/availability/">Manage shared availability and blocks →</a><p>Available periods and blocks are saved for all owners and verified visitors. Times use Eastern Time. Submitted requests hold a slot pending owner approval. Identity and agent validation remain simulated.</p></section>
<section class="card" id="shared-activity"><p class="eyebrow">ACTIVITY · SAVED HISTORY</p><h2>A record of real changes.</h2><p class="hint">Latest 50 recorded changes · Eastern Time. Refresh this page for updates. Includes calendar edits, owner invitations/removals, password setup/reset, completed visitor verification, saved profiles, booking requests/approvals/cancellations and visitor-booking settings. Sample actions below stay in the sample log.</p>{activityError?<p role="status">Activity could not be loaded. Refresh to try again.</p>:activity.length?<ol class="log">{activity.map(item=><li><strong>{item.title}</strong><br /><time datetime={new Date(item.createdAt).toISOString()}>{activityTime.format(item.createdAt)}</time> · {item.actor}{item.detail&&<p>{item.detail}</p>}</li>)}</ol>:<p>No recorded changes yet.</p>}</section></div>
<section class="card dashboard-settings"><h2>Visitor booking settings</h2><p>Visitor email verification and booking requests: <strong>{demoEnabled?'Enabled':'Disabled'}</strong></p><form id="visitor-demo-settings"><label class="check"><input id="visitor-demo-enabled" type="checkbox" checked={demoEnabled} /> Enable visitor email verification and booking requests</label><p class="hint">When off, visitor verification, profiles, calendar access and booking actions are blocked. Owners can still manage availability and requests. Existing records are retained. An email already being sent cannot be recalled. Test-recipient restrictions and rate limits still apply when enabled.</p><button class="button" type="submit">Save visitor settings</button></form><p id="visitor-settings-result" role="status"></p></section><div class="two-col"><section class="card"><h2>Viewing requests</h2><p>{counts?.count??0} upcoming requests awaiting review.</p><p>Pending requests hold their time until approved or canceled. Identity/agent checks remain simulated; no booking email or lockbox access is issued.</p></section><section class="card"><h2>Visitor email verification</h2><ul>{visitors.results.map(v=><li>{v.email_normalized} · {v.email_verified_at?'Email verified':'Awaiting verification'}</li>)}</ul>{!visitors.results.length&&<p>No visitor records yet.</p>}</section>
<section class="card"><h2>Owner accounts</h2><p>All active owners have equal permissions. Owner invitations can use any valid email address, independently of the visitor test domains.</p><ul>{owners.results.map(o=><li>{o.email_normalized} · {o.status} <button type="button" class="text-button" data-remove-owner={o.id}>Remove owner</button></li>)}</ul><form id="owner-invite"><label for="invite-email">New owner's email</label><input id="invite-email" type="email" required maxlength="254" /><button class="button" type="submit">Send owner invitation</button></form><p id="owner-action-result" role="status"></p></section></div><section class="card dashboard-settings"><h2>Saved viewing requests</h2><p>Up to 100 requests, with upcoming pending/approved visits first. Visitor-provided details below are not independently verified.</p><BookingRequests bookings={bookings} owner /></section><section class="intro" aria-labelledby="workflow-heading"><p class="eyebrow">INTERACTIVE WORKFLOW PREVIEW</p><h2 id="workflow-heading">Plan and review a viewing.</h2><p>These sample controls demonstrate requests, automation and conversations. They use fictional data, do not send emails or create access codes, and do not change the real records above. Sample changes and their activity log clear when this page reloads.</p></section><OwnerWorkflowDemo connected /><script>import '../../scripts/owner-dashboard';</script></ViewingLayout>
