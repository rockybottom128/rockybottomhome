---
export const prerender=false;
import ViewingLayout from '../../layouts/ViewingLayout.astro';
import Messages from '../../components/Messages.astro';
import {runtime} from '../../server/runtime';
import {configured} from '../../server/env';
import {getVisitor} from '../../server/visitor-auth';
import {visitorDemoEnabled} from '../../server/settings';
const env=runtime();
if(!configured(env,Astro.request)||!await visitorDemoEnabled(env)||!await getVisitor(env,Astro.request))return Astro.redirect('/viewings/',303);
---
<ViewingLayout title="My messages"><section class="intro"><p class="eyebrow">YOUR VISIT · YOUR CONVERSATIONS</p><h1>Keep in touch.</h1><p>Start a conversation while you have a pending or approved request. Existing threads remain available after a visit is completed or canceled.</p></section><Messages /></ViewingLayout>
