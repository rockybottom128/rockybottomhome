{
  "name": "rockybottomhome-auth-local",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rockybottomhome-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000003",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:4324",
    "AUTH_ENABLED": "true",
    "MAIL_MODE": "test",
    "MAIL_FROM": "bookings@notify.rockybottomhome.com",
    "MAIL_REPLY_TO": "bookings@rockybottomhome.com",
    "MAIL_ALLOWED_RECIPIENTS": "owner@example.com,visitor@example.com",
    "BOOTSTRAP_OWNER_EMAIL": "owner@example.com",
    "VISITOR_EMAIL_DOMAINS": "farts.cloud,scottdempsey.com,table42.cafe"
  }
}
