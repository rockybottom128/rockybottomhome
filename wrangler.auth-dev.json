{
  "name": "rockybottomhome-auth-dev",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rockybottomhome-auth-dev",
      "database_id": "46691edf-8f7d-48e2-9e72-0586cef46e99",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://rockybottomhome-auth-dev.accts-e61.workers.dev",
    "AUTH_ENABLED": "true",
    "MAIL_MODE": "resend",
    "MAIL_FROM": "bookings@notify.rockybottomhome.com",
    "MAIL_REPLY_TO": "bookings@rockybottomhome.com"
  },
  "account_id": "e6144913ec6fa3b523d5d7e50cce2c40",
  "workers_dev": true
}
