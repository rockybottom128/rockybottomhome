{
	"name": "rockybottomhome",
	"description": "Build a personal website, blog, or portfolio with Astro.",
	"cloudflare": {
		"label": "Astro Framework Starter",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
		"publish": true
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.4",
		"@astrojs/mdx": "8.0.3",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.6.1",
		"@better-auth/drizzle-adapter": "1.7.7",
		"astro": "7.3.8",
		"better-auth": "1.7.7",
		"drizzle-orm": "0.45.4",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"wrangler": "4.149.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"test:security": "node --test tests/security.test.mjs",
		"test:viewings": "node --experimental-strip-types --test tests/viewings.test.mjs",
		"cf-typegen": "wrangler types",
		"check": "astro build && tsc && npm run test:security && npm run test:version && npm run test:viewings && npm run test:mail && npm run test:settings && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"preview": "astro build && wrangler dev",
		"version:prepare": "node scripts/versioning.mjs prepare",
		"version:check": "node scripts/versioning.mjs check",
		"test:version": "node --test tests/versioning.test.mjs",
		"build:auth-local": "RB_LOCAL_AUTH=1 astro build",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.auth-local.json",
		"test:auth:local": "node tests/auth-integration.mjs",
		"test:mail": "node --test tests/mail.test.mjs",
		"test:settings": "node --test tests/settings.test.mjs",
		"build:auth-dev": "node scripts/development/auth-dev.mjs build",
		"deploy:auth-dev": "node scripts/development/auth-dev.mjs deploy",
		"publish:dev": "node scripts/development/publish-dev.mjs",
		"test:auth:isolated": "node scripts/development/test-auth.mjs",
		"test:auth-dev-policy": "node --test tests/auth-dev-policy.test.mjs tests/dev-snapshot.test.mjs",
		"test:build-target": "node --test tests/build-target.test.mjs"
	},
	"type": "module"
}
